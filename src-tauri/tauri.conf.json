{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Story Studio",
  "version": "0.1.2",
  "identifier": "town.cafero.storystudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Story Studio · AI 小说创作",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist": "webapp/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENzYwODZENEYyQjJENUIKUldSYkxTdFBiUWgyTFl3aU80ODV5UTd4OGFDcnViVlBYWW1LQVRzRWVLTXNJeGk2SlFkOFdTKzEK",
      "endpoints": [
        "https://github.com/binlipu404-star/story-studio/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/binlipu404-star/story-studio/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
